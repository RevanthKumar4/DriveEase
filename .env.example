# ============================================================
# DriveEase — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to Git.
# ============================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev

# --- Server ---
SERVER_PORT=8080

# --- Database ---
DATABASE_URL=jdbc:mysql://localhost/appdb?createDatabaseIfNotExist=true
DATABASE_USERNAME=
DATABASE_PASSWORD=

# --- JWT ---
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Mail (Gmail SMTP) ---
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Gemini AI ---
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-lite:generateContent

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8081

# --- JPA (dev only) ---
JPA_DDL_AUTO=update
